# ==============================================================================
# Ecom Ventures - Canonical Production VPS Environment Configuration Template
# Target VPS: 185.227.134.236 (User: ecom, Path: /home/ecom/ecom_ventures)
# Note: Rename to .env.production on the VPS. Never commit actual .env.production to Git.
# ==============================================================================

# Server Core Runtime
PORT=5000
APP_ENV=production
APP_DEBUG=false

# Canonical Database Configuration (Shared PostgreSQL 16 on 127.0.0.1:5432)
# Strictly isolated from Poshplex: DO NOT ALTER OR DROP poshplex DB
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ecom_user
DB_PASSWORD=Strong_Ecom_Pass_2026
DB_MAIN_NAME=ecom_platform_main
DB_TEMPLATE_NAME=ecom_store_template
DB_SSLMODE=disable

# Shared Redis Cache (Shared Redis 7 on 127.0.0.1:6379)
# DB 0 is assigned to Ecom Ventures; DB 1 is STRICTLY RESERVED for Poshplex
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
REDIS_PASSWORD=

# Security & Symmetric Authenticated Encryption (AES-256-GCM 32-byte key)
JWT_SECRET=replace_with_secure_production_jwt_secret_key_32bytes!
DATABASE_ENCRYPTION_KEY=replace_with_secure_prod_db_key_32bytes!

# Routing & Edge Host Domains
MASTER_ADMIN_DOMAIN=master.ecomventures.com
STORE_ADMIN_DOMAIN=admin.ecomventures.com
PUBLIC_STOREFRONT_DOMAIN=ecomventures.com

# Cloudflare R2 Object Storage (Configurable dynamically from Master Admin Panel)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=
