# Stage 1: Build Master Admin SPA
FROM node:20-alpine AS master-builder
WORKDIR /app
COPY apps/master-admin/package*.json ./
RUN npm install
COPY apps/master-admin/ ./
RUN npm run build

# Stage 2: Build Store Admin SPA
FROM node:20-alpine AS store-builder
WORKDIR /app
COPY apps/store-admin/package*.json ./
RUN npm install
COPY apps/store-admin/ ./
RUN npm run build

# Stage 3: Serve both SPAs via Nginx Alpine on internal port 5200 (mapped to 80)
FROM nginx:1.25-alpine AS runner

COPY --from=master-builder /app/dist /usr/share/nginx/html/master
COPY --from=store-builder /app/dist /usr/share/nginx/html/store

COPY infra/nginx/admin_nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
