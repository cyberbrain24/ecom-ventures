# ==============================================================================
# ECOM VENTURES CENTRAL CONFIGURATION TEMPLATE
# Copy to .env in your root directory and adjust values as needed.
# ==============================================================================

# Server Environment
APP_ENV=development
PORT=8080
LOG_LEVEL=debug

# Central Platform Database (Holds store registry and global metadata)
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=platform_user
PLATFORM_DB_PASSWORD=platform_secure_password_2026
PLATFORM_DB_NAME=ecom_platform_main
PLATFORM_DB_SSLMODE=disable
PLATFORM_DB_MAX_OPEN_CONNS=25
PLATFORM_DB_MAX_IDLE_CONNS=10
PLATFORM_DB_CONN_MAX_LIFETIME=5m

# Dedicated Store Database Prototype & Provisioning Settings
STORE_DB_TEMPLATE_HOST=localhost
STORE_DB_TEMPLATE_PORT=5433
STORE_DB_TEMPLATE_USER=store_prototype_user
STORE_DB_TEMPLATE_PASSWORD=store_secure_password_2026
STORE_DB_TEMPLATE_NAME=ecom_store_template
STORE_DB_TEMPLATE_SSLMODE=disable

# Redis Caching & Queue Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2026
REDIS_DB=0

# Security & Token Signatures
JWT_SECRET=super_secure_jwt_secret_key_minimum_32_characters_long_2026
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Platform Base Domains
MASTER_ADMIN_DOMAIN=master.dropiobd.localhost
STORE_ADMIN_DOMAIN=store.dropiobd.localhost
PLATFORM_ROOT_DOMAIN=dropiobd.localhost

# Local/test-only fixture seed command (export these variables before running it)
SEED_LOCAL_FIXTURES=false
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_STORE_OWNER_PASSWORD=
